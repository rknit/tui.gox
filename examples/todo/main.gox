//go:generate go run github.com/rknit/tui.gox/cmd/goxc .

package main

import (
	"fmt"
	"os"
	"strings"

	"github.com/rknit/tui.gox/gox"
)

type Todo struct {
	ID   int
	Text string
	Done bool
}

type action struct {
	kind string // add | toggle | clear
	id   int
	text string
}

func reducer(todos []Todo, a action) []Todo {
	switch a.kind {
	case "add":
		next := 1
		for _, t := range todos {
			next = max(next, t.ID+1)
		}
		return append(append([]Todo{}, todos...), Todo{ID: next, Text: a.text})
	case "toggle":
		out := append([]Todo{}, todos...)
		for i := range out {
			if out[i].ID == a.id {
				out[i].Done = !out[i].Done
			}
		}
		return out
	case "clear":
		var out []Todo
		for _, t := range todos {
			if !t.Done {
				out = append(out, t)
			}
		}
		return out
	}
	return todos
}

type TodoItemProps struct {
	Todo     Todo
	OnToggle func()
}

func TodoItem(p TodoItemProps) gox.Node {
	color := ""
	if p.Todo.Done {
		color = "8"
	}
	return (
		<checkbox checked={p.Todo.Done} onChange={func(bool) { p.OnToggle() }}>
			<span color={color} strikethrough={p.Todo.Done}>{p.Todo.Text}</span>
		</checkbox>
	)
}

func App() gox.Node {
	todos, dispatch := gox.UseReducer(reducer, []Todo{
		{ID: 1, Text: "Write a .gox component"},
		{ID: 2, Text: "Run goxc", Done: true},
	})
	draft, setDraft := gox.UseState("")

	left := 0
	for _, t := range todos {
		if !t.Done {
			left++
		}
	}

	submit := func(s string) {
		if strings.TrimSpace(s) != "" {
			dispatch(action{kind: "add", text: strings.TrimSpace(s)})
			setDraft("")
		}
	}

	return (
		<box border="rounded" borderColor="12" title="todos" padding={1} gap={1} width={60}>
			<input
				value={draft}
				onChange={setDraft}
				onSubmit={submit}
				prompt="› "
				focusColor="12"
				placeholder="What needs to be done?"
				autoFocus
			/>
			<show when={len(todos) > 0} fallback={<text faint>Nothing to do.</text>}>
				<box>
					{gox.Map(todos, func(t Todo, _ int) gox.Node {
						return <TodoItem key={t.ID} todo={t} onToggle={func() { dispatch(action{kind: "toggle", id: t.ID}) }} />
					})}
				</box>
			</show>
			<divider color="8" />
			<box direction="row">
				<text faint>{left} item(s) left</text>
				<spacer />
				<button onPress={func() { dispatch(action{kind: "clear"}) }}>clear done</button>
			</box>
		</box>
	)
}

func main() {
	if err := gox.Run(<App />); err != nil {
		fmt.Println(err)
		os.Exit(1)
	}
}
